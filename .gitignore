# Raw dataset: kept in git through Git LFS (see .gitattributes), so a clone
# restores it with `git lfs pull`. Its canonical source is PhysioNet.

# Derived artifacts — reproducible from raw data, never commit
cache/
artifacts/*
# ...except the model the site serves (configs/default.yaml, serve.model):
# 170 KB, and a deployment built from this repository has nothing to serve
# without it. It carries its own SHA-256, checked before it is loaded.
!artifacts/mi_four_class__riemann_ts_aligned/
reports/
uploads/

# Superseded outputs from the v1 pipeline (kept on disk, not in git)
processed_data/
models/

