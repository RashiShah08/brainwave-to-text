# Keep the serving image small: it needs the package, templates and config,
# nothing else. Training happens outside the container.

.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# 3.5 GB of EDF has no business in a production image
raw_data/
cache/
reports/
uploads/

tests/
docs/
*.md
!README.md
